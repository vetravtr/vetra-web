---
export interface Props {
  className?: string;
}
const { className } = Astro.props;
import Badge from "../Badge.astro";
import SectionLayout from "../../layouts/SectionLayout.astro";
import AlignmentLayout from "../../layouts/AlignmentLayout.astro";
import Title from "../Title.astro";
import Description from "../Description.astro";

const faqItems = [
  {
    q: "How can I buy VTR?",
    a: "Through our OTC desk. Send us a quote request with your name, email, country and the Polygon wallet address that will receive the VTR. We reply with the current quote — amount, quantity of VTR, receiving address and how long the quote is valid for. Once your USDC or USDT payment is confirmed on-chain, we send the VTR to your wallet.",
  },
  {
    q: "How is the price calculated?",
    a: "The reference is the current market price of VTR on the Uniswap V3 pool on Polygon — public and verifiable on-chain by anyone. The quote you receive is locked for 30 minutes, so the price you accept is the price you pay.",
  },
  {
    q: "Which tokens do you accept?",
    a: "USDC or USDT on the Polygon network only. Please do not send from other networks (Ethereum, BSC and others) — funds sent on a different network cannot be recovered.",
  },
  {
    q: "What is the minimum purchase?",
    a: "The minimum is US$ 50 per operation. For operations above US$ 1,000 we ask for a simple identification (name and document) before completing the exchange. Operations above US$ 5,000 are arranged directly with our team.",
  },
  {
    q: "How long does it take to receive the VTR?",
    a: "Once your payment is confirmed on-chain, the VTR is sent to the wallet address you provided — usually within a few hours on working days. Both transactions (your payment and our VTR transfer) are public on Polygonscan.",
  },
  {
    q: "Do I need to connect a wallet?",
    a: "No. There is nothing to connect or sign. You simply tell us the wallet address where you want to receive the VTR — any Polygon wallet works (SafePal, MetaMask, Trust Wallet, Rabby, KuCoin Wallet and others).",
  },
  {
    q: "Is VTR a stablecoin?",
    a: "No. VTR is the utility and governance token of the VETRA protocol on Polygon. It is not pegged to any fiat currency; its market value is determined by liquidity and market demand.",
  },
  {
    q: "What backs the value of VTR?",
    a: "VTR is not backed by a fixed reserve. Its value comes from what already exists and works today: on-chain governance, real liquidity on Uniswap V3, and open-market trading. All token parameters (supply, maximum cap and transfers) are verifiable on-chain.",
  },
  {
    q: "Are there any returns or guaranteed value?",
    a: "No. VTR is sold as a utility and governance token — not as an investment. No return, yield, buyback or guaranteed value is offered, promised or implied. What you receive are governance and usage rights over the protocol.",
  },
  {
    q: "How do I get USDC or USDT on Polygon?",
    a: "You can buy USDC or USDT on exchanges like KuCoin, Binance or OKX, then withdraw directly to your wallet on the Polygon network — just select Polygon as the withdrawal network.",
  },
];

const cn = (...args: (string | undefined | false | null)[]) =>
  args.filter(Boolean).join(' ');
const outerClasses = cn(
  "flex items-center w-full relative",
);
const innerClasses = cn(
  "w-full h-fit py-[88px]",
);
const layoutClasses = cn(
  "gap-[80px] h-[-webkit-fill-available] relative z-10",
);
const listClasses = cn(
  "w-full max-w-[768px] mx-auto flex flex-col gap-4",
);
const borderClasses =
  "bg-white/[0.03] border border-white/[0.06] rounded-xl";
const hoverClasses = "transition-all duration-300";
const textGrey = "text-text-grey";
const textWhite = "text-white";

const TEXT_14_18 = "font-sans font-medium text-text-secondary text-[14px] leading-[18px] max-md:text-[14px] max-md:leading-[18px]";
const TEXT_12_16 = "font-serif text-[12px] leading-[16px] max-md:text-[12px] max-md:leading-[16px]";
---

<section id="faq">
<SectionLayout outerClassName={outerClasses} innerClassName={innerClasses} autoMargin={true}>
  <AlignmentLayout direction="vertical" justify="center" align="center" className={layoutClasses}>
    <AlignmentLayout direction="vertical" justify="center" align="center" className="w-full max-w-[656px]" style="gap: 1.5rem;">
      <Badge text="FAQ" />
      <AlignmentLayout direction="vertical" justify="center" align="center" className="gap-2">
        <Title text="Frequently asked questions" className="text-center" />
        <Description text="Everything you need to know about buying VTR." className="max-w-[588px] text-center" />
      </AlignmentLayout>
    </AlignmentLayout>

    <div class={listClasses}>
      {faqItems.map((item, i) => (
        <div class={`${borderClasses} px-6 py-4 ${hoverClasses}`}>
          <div
            class="flex items-center justify-between text-white font-medium text-sm cursor-pointer"
            onclick="this.parentElement.classList.toggle('faq-open')"
          >
            <span>{item.q}</span>
            <span class="text-light-purple text-lg transition-transform duration-300 shrink-0 ml-4 faq-arrow inline-block">&#9660;</span>
          </div>
          <p class="mt-3 text-text-grey text-sm leading-relaxed hidden faq-answer">{item.a}</p>
        </div>
      ))}
    </div>
  </AlignmentLayout>
</SectionLayout>
</section>

<style>
  .faq-open .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-open .faq-answer {
    display: block !important;
  }
  /* Remove qualquer marcador residual */
  details > summary {
    list-style: none !important;
  }
  details > summary::marker,
  details > summary::-webkit-details-marker {
    display: none !important;
    content: "" !important;
  }
</style>
